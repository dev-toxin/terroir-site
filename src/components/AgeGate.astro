---
/**
 * Unobtrusive 18+ notice. Hidden by default (`hidden`) — site.js reveals it only if the visitor
 * hasn't confirmed yet (remembered in localStorage). Without JS the site stays fully readable; the 18+
 * line lives in the footer. Since 2026-10 it is an in-flow strip above the header, not an overlay.
 */
import { t } from '../i18n/ui';
import type { Lang } from '../config';
interface Props { lang: Lang }
const s = t(Astro.props.lang);
---

<section class="agegate on-dark" data-agegate hidden aria-labelledby="agegate-title" role="region">
  <div class="agegate__inner">
    <span class="agegate__badge" aria-hidden="true">18+</span>
    <div data-age-body class="agegate__body">
      <p class="agegate__title" id="agegate-title">{s.age.title}</p>
      <p class="agegate__text">{s.age.text}</p>
    </div>
    <p data-age-under class="agegate__under" hidden tabindex="-1">{s.age.under}</p>
    <div class="agegate__actions">
      <button type="button" class="btn btn--sm" data-age-yes>{s.age.yes}</button>
      <button type="button" class="btn btn--sm btn--ghost" data-age-no>{s.age.no}</button>
    </div>
  </div>
</section>

<style>
  /* 2026-10: an in-flow strip at the very top of the page (not fixed, not floating), so it never covers
     the hero, the CTA or the facts on any screen. One line on desktop, two at most on phones. */
  .agegate {
    position: relative;
    z-index: 5;
    border-bottom: 1px solid rgb(168 135 79 / 0.5);
    padding: var(--s-2) var(--s-4);
  }
  .agegate[hidden], .agegate [hidden] { display: none; }
  .agegate__inner { display: flex; align-items: center; gap: var(--s-3); max-width: 72rem; margin-inline: auto; }
  .agegate__badge {
    display: inline-grid; place-items: center; flex: none;
    width: 2rem; height: 2rem; border-radius: 50%;
    border: 1px solid var(--c-gold); color: var(--c-gold-soft);
    font-family: var(--f-display); font-style: italic; font-size: 1rem;
  }
  .agegate__body, .agegate__under { flex: 1 1 auto; min-width: 0; display: flex; flex-wrap: wrap; align-items: baseline; gap: 0 var(--s-3); }
  .agegate p { margin: 0; }
  .agegate__title { font-family: var(--f-display); font-size: 1.05rem; line-height: 1.2; }
  .agegate__text { display: none; color: var(--c-muted-dark); font-size: 0.875rem; }
  .agegate__under { color: var(--c-muted-dark); font-size: 0.875rem; }
  .agegate__actions { flex: none; display: flex; gap: var(--s-2); }
  .agegate .btn--sm { min-height: 36px; padding: 0.3rem 0.8rem; font-size: 0.875rem; }
  .agegate .btn:not(.btn--ghost) { --_bg: var(--c-cream); --_fg: var(--c-ink); --_bd: var(--c-cream); }
  .agegate .btn:not(.btn--ghost):hover { --_bg: var(--c-gold-soft); --_bd: var(--c-gold-soft); }
  .agegate .btn--ghost { --_fg: var(--c-cream); --_bd: rgb(250 246 239 / 0.4); }
  .agegate .btn--ghost:hover { --_bg: var(--c-cream); --_fg: var(--c-ink); }
  @media (min-width: 768px) {
    .agegate__text { display: block; }
  }
</style>
