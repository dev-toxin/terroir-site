---
import Base from '../layouts/Base.astro';
import CellarMockup from '../components/CellarMockup.astro';
import TableScene from '../components/TableScene.astro';
import PairingDiagram from '../components/PairingDiagram.astro';
import SecHead from '../components/SecHead.astro';
import Icon from '../components/Icon.astro';
import MarginNote from '../components/MarginNote.astro';
import CtaBand from '../components/CtaBand.astro';
import { t, localize, ROUTES } from '../i18n/ui';
import { ARTICLES } from './articles';
import { SITE, type Lang } from '../config';

interface Props { lang: Lang }
const { lang } = Astro.props;
const s = t(lang);
const L = (p: string) => localize(lang, p);

const C = {
  en: {
    title: 'Terroir — a wine assistant that knows your cellar, your taste and your kitchen',
    description: 'Terroir remembers the bottles you own, how you like your wine and what you cook — and answers “what should I open tonight?” from your own shelf. Early access: web app and Telegram.',
    kicker: 'Early access · web app & Telegram',
    h1: 'What to open tonight — <em>from your own cellar.</em>',
    sub: 'Terroir is a personal wine assistant with a memory. It knows which bottles you have and where they lie, how you like your wine, and what you cook at home — so its answers come from your shelf, not from the whole internet.',
    cta2: 'See how it works',
    note: 'real answers come only from bottles you actually own',
    facts: [['10–200', 'bottles at home'], ['3', 'things it remembers'], ['0', 'bottles it will sell you']],
    cellar: {
      no: '01',
      title: 'Your cellar, <em>remembered</em>',
      lede: 'Every bottle is a label on a shelf: how many are left, where it lies and when its drinking window opens and closes. Terroir keeps that memory between conversations.',
      items: [
        { icon: 'rack', h: 'Your cellar', p: 'Ten bottles in a kitchen rack or two hundred in a basement — same care, same shelf map.' },
        { icon: 'palate', h: 'Your taste', p: 'A short questionnaire to start, then every rating sharpens the picture — learnt from what you drink.' },
        { icon: 'book', h: 'Your kitchen', p: 'The dishes you actually cook. Wine for your recipes, and a recipe for the bottle you have.' },
      ],
    },
    evening: {
      no: '02',
      title: 'One week, <em>three evenings</em>',
      lede: 'This is what Terroir is for — not tasting notes for their own sake, but small decisions at home.',
      items: [
        { day: 'Friday, 19:40', h: 'What to open with dinner?', p: 'Duck breast is resting, you’re tired, you don’t want to think. Terroir looks at the shelf: “Saperavi 2018 is entering its peak, you have three. You liked the last one more after an hour open.”', tag: 'from the cellar', icon: 'glass' },
        { day: 'Saturday, guests at eight', h: 'Friends are coming for an Italian night', p: 'Ragù is on the stove, six people, a mix of tastes. Terroir suggests two bottles you own that will cover the table — and notes which one your partner tends to prefer.', tag: 'from your recipes', icon: 'pair' },
        { day: 'Some quiet Sunday', h: 'The bottle you’ve been saving', p: 'Everyone has one. Terroir remembers it too, and tells you gently when its window starts to close — so it’s opened at its best, not forgotten until it’s past.', tag: 'drinking window', icon: 'calendar' },
      ],
    },
    pairing: {
      no: '03',
      title: 'Wine <em>↔</em> your recipe',
      lede: 'This is the part catalogue apps can’t do. Terroir pairs from both of your shelves at once: the recipes you cook and the bottles you keep.',
      recipe: { kicker: 'From your kitchen', name: 'Pork neck on charcoal', meta: 'your Sunday recipe', notes: ['smoke and char', 'fat that needs grip', 'adjika on the side'] },
      wine: { kicker: 'From your cellar', name: 'Krasnostop 2019', meta: 'shelf B · 2 bottles left', notes: ['firm tannin', 'dark fruit, a little smoke', 'at the peak of its window'] },
      why: 'tannin cuts the fat, smoke meets smoke',
      foot: 'And the other way round: open a bottle — Terroir suggests what to cook from your own recipes.',
    },
    notThis: {
      no: '04',
      title: 'Not another label scanner. <em>Not a chat that forgets.</em>',
      lede: 'There are apps that know every wine in the world, and chatbots that will talk about any of them. Neither knows what’s on your shelf tonight.',
      leftH: 'What Terroir isn’t',
      left: [
        'A catalogue of every wine ever made, with somebody else’s ratings',
        'A chat that starts from zero each time and recommends bottles you don’t own',
        'A shop, a marketplace or an affiliate link in disguise',
      ],
      rightH: 'What Terroir is',
      right: [
        'An inventory of your bottles, with quantities, places and drinking windows',
        'A memory of your taste and your recipes that gets better with every rating',
        'An assistant that answers only from what you have — and says so when nothing fits',
      ],
    },
    journal: { no: '05', title: 'From the <em>journal</em>', lede: 'Short, practical notes about keeping and opening wine at home.', read: 'Read', all: 'All notes' },
    privacy: {
      title: 'Your cellar is <em>your data</em>',
      items: [
        ['Export anytime', 'Your whole cellar, ratings and notes as a CSV file.'],
        ['No selling, no ads', 'We don’t take money from wineries to push bottles.'],
        ['Delete anytime', 'Ask once, and your account and data are erased.'],
      ],
      link: 'Privacy notice (draft)',
    },
  },
  ru: {
    title: 'Terroir — винный помощник, который знает ваш погреб, вкус и кухню',
    description: 'Terroir помнит, какие бутылки у вас есть, какое вино вам нравится и что вы готовите, — и отвечает на вопрос «что открыть сегодня?» из вашего собственного погреба. Ранний доступ: веб и Telegram.',
    kicker: 'Ранний доступ · веб и Telegram',
    h1: 'Что открыть сегодня — <em>из своего погреба.</em>',
    sub: 'Terroir — личный винный помощник с памятью. Он знает, какие бутылки у вас есть и где они лежат, какое вино вам по вкусу и что вы готовите дома. Поэтому отвечает из вашей полки, а не из всего интернета.',
    cta2: 'Как это работает',
    note: 'советует только то, что реально стоит у вас на полке',
    facts: [['10–200', 'бутылок дома'], ['3', 'вещи, которые он помнит'], ['0', 'бутылок, которые он вам продаст']],
    cellar: {
      no: '01',
      title: 'Ваш погреб — <em>в памяти</em>',
      lede: 'Каждая бутылка — этикетка на полке: сколько осталось, где лежит, когда открывается и закрывается окно питья. Terroir хранит эту память между разговорами.',
      items: [
        { icon: 'rack', h: 'Ваш погреб', p: 'Десять бутылок на кухне или двести в подвале — одинаково бережно и с картой полок.' },
        { icon: 'palate', h: 'Ваш вкус', p: 'Короткий опрос на старте, дальше каждая оценка уточняет картину — по тому, что вы пьёте.' },
        { icon: 'book', h: 'Ваша кухня', p: 'Блюда, которые вы правда готовите. Вино к вашим рецептам и рецепт — к вашей бутылке.' },
      ],
    },
    evening: {
      no: '02',
      title: 'Одна неделя, <em>три вечера</em>',
      lede: 'Вот для чего Terroir: не дегустационные заметки ради заметок, а маленькие домашние решения.',
      items: [
        { day: 'Пятница, 19:40', h: 'Что открыть к ужину?', p: 'Утиная грудка отдыхает, сил думать нет. Terroir смотрит на полку: «Саперави 2018 входит в пик, у вас три бутылки. Прошлую вы оценили выше, когда она постояла открытой час».', tag: 'из погреба', icon: 'glass' },
        { day: 'Суббота, гости к восьми', h: 'Друзья придут на итальянский ужин', p: 'Рагу на плите, шесть человек, вкусы разные. Terroir предложит две ваши бутылки, которые закроют весь стол, и подскажет, какую из них обычно выбирает ваш партнёр.', tag: 'из ваших рецептов', icon: 'pair' },
        { day: 'Какое-нибудь тихое воскресенье', h: 'Бутылка, которую жалко открывать', p: 'Такая есть у всех. Terroir тоже её помнит и мягко подскажет, когда окно начнёт закрываться, — чтобы открыть её в лучшей форме, а не вспомнить слишком поздно.', tag: 'окно питья', icon: 'calendar' },
      ],
    },
    pairing: {
      no: '03',
      title: 'Вино <em>↔</em> ваш рецепт',
      lede: 'Этого не умеют приложения-каталоги. Terroir подбирает пару сразу из двух ваших полок: рецептов, которые вы готовите, и бутылок, которые вы храните.',
      recipe: { kicker: 'С вашей кухни', name: 'Свиная шея на углях', meta: 'ваш воскресный рецепт', notes: ['дым и корочка', 'жир, которому нужна терпкость', 'аджика к столу'] },
      wine: { kicker: 'Из вашего погреба', name: 'Красностоп 2019', meta: 'полка B · осталось 2 бутылки', notes: ['плотные танины', 'тёмные ягоды, немного дыма', 'пик окна питья'] },
      why: 'танины режут жир, дым встречает дым',
      foot: 'И в обратную сторону: открываете бутылку — Terroir подскажет, что приготовить из ваших же рецептов.',
    },
    notThis: {
      no: '04',
      title: 'Не очередной сканер этикеток. <em>Не чат, который забывает.</em>',
      lede: 'Есть приложения, которые знают все вина мира, и чат-боты, готовые поговорить о любом из них. Ни те, ни другие не знают, что стоит у вас на полке сегодня.',
      leftH: 'Чем Terroir не является',
      left: [
        'Каталогом всех вин на свете с чужими оценками',
        'Чатом, который каждый раз начинает с нуля и советует то, чего у вас нет',
        'Магазином, маркетплейсом или замаскированной партнёрской ссылкой',
      ],
      rightH: 'Что такое Terroir',
      right: [
        'Учёт ваших бутылок: количество, место, окно питья',
        'Память о вашем вкусе и рецептах, которая точнее с каждой оценкой',
        'Помощник, который отвечает только из того, что у вас есть, — и честно говорит, если ничего не подходит',
      ],
    },
    journal: { no: '05', title: 'Из <em>журнала</em>', lede: 'Короткие практичные заметки о том, как хранить и открывать вино дома.', read: 'Читать', all: 'Все заметки' },
    privacy: {
      title: 'Ваш погреб — <em>ваши данные</em>',
      items: [
        ['Экспорт в любой момент', 'Весь погреб, оценки и заметки — одним CSV-файлом.'],
        ['Без продажи данных и рекламы', 'Мы не берём денег у виноделен за продвижение бутылок.'],
        ['Удаление в любой момент', 'Попросите один раз — аккаунт и данные будут удалены.'],
      ],
      link: 'Политика конфиденциальности (черновик)',
    },
  },
}[lang];

const notes = ARTICLES.map((a) => ({ slug: a.slug, ...a[lang] }));

const app = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'Terroir',
  applicationCategory: 'LifestyleApplication',
  operatingSystem: 'Web, Telegram',
  description: C.description,
  url: new URL(L('/'), SITE.url).href,
  inLanguage: lang,
  publisher: { '@id': `${SITE.url}/#org` },
};
---

<Base lang={lang} title={C.title} fullTitle description={C.description} path="/" jsonld={[app]}>
  <!-- HERO · a table with wine -->
  <section class="hero">
    <div class="wrap hero__grid">
      <div class="hero__copy">
        <p class="kicker rise">{C.kicker}</p>
        <h1 class="rise rise-1" set:html={C.h1} />
        <p class="lede rise rise-2">{C.sub}</p>
        <div class="btn-row rise rise-3">
          <a class="btn" href={L(ROUTES.early)}>{s.cta}</a>
          <a class="btn btn--ghost" href={L(ROUTES.how)}>{C.cta2}</a>
        </div>
        <dl class="facts">
          {C.facts.map(([n, l]) => (
            <div><dt class="tnum">{n}</dt><dd>{l}</dd></div>
          ))}
        </dl>
      </div>
      <div class="hero__visual">
        <!-- TODO: photo (local generation, see 🎨 Генерация графики) — still life of a dinner table, no real labels -->
        <TableScene />
        <MarginNote class="hero__note" dir="left">{C.note}</MarginNote>
      </div>
    </div>
  </section>

  <!-- 01 · CELLAR (dark) -->
  <section class="section section--dark cellar" aria-labelledby="h-cellar">
    <div class="wrap">
      <SecHead no={C.cellar.no} title={C.cellar.title} lede={C.cellar.lede} id="h-cellar" />
      <div class="cellar__grid">
        <div class="cellar__mock">
          <CellarMockup lang={lang} />
        </div>
        <ul class="cellar__list">
          {C.cellar.items.map((it, i) => (
            <li class="cellar__item">
              <p class="cellar__no" aria-hidden="true">{['I', 'II', 'III'][i]}</p>
              <div>
                <h3><Icon name={it.icon as any} class="cellar__icon" />{it.h}</h3>
                <p>{it.p}</p>
              </div>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <!-- 02 · EVENINGS -->
  <section class="section" aria-labelledby="h-evenings">
    <div class="wrap">
      <SecHead no={C.evening.no} title={C.evening.title} lede={C.evening.lede} id="h-evenings" />
      <ol class="evenings">
        {C.evening.items.map((it) => (
          <li class="evening">
            <div class="evening__when">
              <Icon name={it.icon as any} class="evening__icon" />
              <p class="evening__day">{it.day}</p>
            </div>
            <div>
              <h3>{it.h}</h3>
              <p>{it.p}</p>
              <span class="tag">{it.tag}</span>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- 03 · WINE ↔ RECIPE (the moat) -->
  <section class="section section--paper pairing" aria-labelledby="h-pairing">
    <div class="wrap">
      <SecHead no={C.pairing.no} title={C.pairing.title} lede={C.pairing.lede} id="h-pairing" center />
      <PairingDiagram lang={lang} recipe={C.pairing.recipe} wine={C.pairing.wine} why={C.pairing.why} />
      <p class="pairing__foot">{C.pairing.foot}</p>
    </div>
  </section>

  <!-- 04 · NOT THIS (dark) -->
  <section class="section section--dark" aria-labelledby="h-not">
    <div class="wrap">
      <SecHead no={C.notThis.no} title={C.notThis.title} lede={C.notThis.lede} id="h-not" />
      <div class="grid grid--2 contrast">
        <div class="contrast__col contrast__col--no">
          <h3>{C.notThis.leftH}</h3>
          <ul>{C.notThis.left.map((x) => <li>{x}</li>)}</ul>
        </div>
        <div class="contrast__col contrast__col--yes">
          <h3>{C.notThis.rightH}</h3>
          <ul class="checks">{C.notThis.right.map((x) => <li>{x}</li>)}</ul>
        </div>
      </div>
    </div>
  </section>

  <!-- 05 · JOURNAL -->
  <section class="section section--tight" aria-labelledby="h-journal">
    <div class="wrap">
      <SecHead no={C.journal.no} title={C.journal.title} lede={C.journal.lede} id="h-journal" />
      <ul class="notes">
        {notes.map((a) => (
          <li class="note">
            <p class="note__meta tnum">{a.date} · {a.minutes}</p>
            <h3 class="note__title"><a href={L(`${ROUTES.journal}${a.slug}/`)}>{a.title}</a></h3>
            <p class="note__desc">{a.description}</p>
          </li>
        ))}
      </ul>
      <p class="mt-6"><a class="text-link" href={L(ROUTES.journal)}>{C.journal.all}</a></p>
    </div>
  </section>

  <!-- privacy strip -->
  <section class="section section--tight section--paper" aria-labelledby="h-privacy">
    <div class="wrap privacy">
      <div>
        <h2 id="h-privacy" class="privacy__title" set:html={C.privacy.title} />
        <a class="text-link" href={L(ROUTES.privacy)}>{C.privacy.link}</a>
      </div>
      <dl class="privacy__list">
        {C.privacy.items.map(([dt, dd]) => (
          <div>
            <dt>{dt}</dt>
            <dd>{dd}</dd>
          </div>
        ))}
      </dl>
    </div>
  </section>

  <CtaBand lang={lang} secondary={{ href: L(ROUTES.faq), label: s.nav.faq }} />
</Base>

<style>
  /* hero */
  .hero { padding-block: clamp(2rem, 1.5rem + 3vw, 5rem) var(--s-9); position: relative; overflow: hidden; }
  .hero::before {
    content: '';
    position: absolute;
    inset: -20% -15% auto auto;
    width: 70%;
    height: 90%;
    background: radial-gradient(closest-side, rgb(107 30 46 / 0.12), transparent);
    pointer-events: none;
  }
  .hero__grid { display: grid; grid-template-columns: minmax(0, 1fr); gap: var(--s-7); align-items: center; position: relative; }
  .hero h1 { font-size: var(--fs-6); max-width: 12ch; margin-bottom: var(--s-5); }
  .hero .lede { margin-bottom: var(--s-6); color: var(--c-ink-soft); }
  .hero__visual { position: relative; max-width: 30rem; width: 100%; justify-self: center; }
  :global(.hero__note) { position: absolute; left: -0.5rem; bottom: -2.75rem; margin: 0; }
  @media (min-width: 1024px) {
    .hero__grid { grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr); gap: var(--s-8); }
    .hero__visual { justify-self: end; }
    :global(.hero__note) { left: -3.5rem; }
  }
  @media (max-width: 639px) {
    :global(.hero__note) { position: static; margin-top: var(--s-4); }
  }
  .facts { display: flex; flex-wrap: wrap; gap: var(--s-5) var(--s-7); margin: var(--s-7) 0 0; padding-top: var(--s-5); border-top: 1px solid var(--c-line); }
  .facts div { min-width: 7rem; }
  .facts dt { font-family: var(--f-display); font-size: var(--fs-4); font-weight: 600; line-height: 1; color: var(--c-merlot); }
  .facts dd { margin: var(--s-2) 0 0; font-size: var(--fs--1); letter-spacing: 0.04em; color: var(--c-muted); max-width: 14ch; }

  /* cellar (dark) */
  .cellar__grid { display: grid; gap: var(--s-7); align-items: start; }
  .cellar__mock { min-width: 0; }
  .cellar__list { list-style: none; padding: 0; margin: 0; }
  .cellar__item { display: grid; grid-template-columns: 3rem minmax(0, 1fr); gap: var(--s-4); padding: var(--s-5) 0; border-top: 1px solid var(--c-line-dark); margin: 0; }
  .cellar__item:last-child { border-bottom: 1px solid var(--c-line-dark); }
  .cellar__no { font-family: var(--f-display); font-style: italic; font-size: var(--fs-3); line-height: 1; color: var(--c-gold); margin: 0; }
  .cellar__item h3 { display: flex; align-items: center; gap: 0.6rem; font-size: var(--fs-2); margin-bottom: var(--s-2); color: var(--c-cream); }
  :global(.cellar__icon) { width: 1.75rem; height: 1.75rem; color: var(--c-gold-soft); flex: none; }
  .cellar__item p { margin: 0; color: var(--c-muted-dark); }
  @media (min-width: 1024px) {
    .cellar__grid { grid-template-columns: minmax(0, 7fr) minmax(0, 5fr); gap: var(--s-8); }
  }

  /* evenings */
  .evenings { list-style: none; padding: 0; margin: 0; }
  .evening {
    display: grid;
    gap: var(--s-3) var(--s-7);
    padding-block: var(--s-6);
    border-top: 1px solid var(--c-line);
    margin: 0;
  }
  .evening:last-child { border-bottom: 1px solid var(--c-line); }
  .evening__when { display: flex; align-items: center; gap: var(--s-3); }
  :global(.evening__icon) { width: 2.5rem; height: 2.5rem; color: var(--c-gold); flex: none; }
  .evening__day { font-family: var(--f-display); font-style: italic; font-size: var(--fs-2); color: var(--c-merlot); line-height: 1.2; margin: 0; }
  .evening h3 { font-size: var(--fs-3); font-weight: 600; margin-bottom: var(--s-3); }
  .evening p { max-width: 60ch; color: var(--c-ink-soft); }
  @media (min-width: 1024px) {
    .evening { grid-template-columns: 17rem minmax(0, 1fr); }
    .evening__when { flex-direction: column; align-items: flex-start; }
  }

  /* pairing */
  .pairing__foot { text-align: center; margin: var(--s-7) auto 0; max-width: 52ch; color: var(--c-ink-soft); font-size: var(--fs-1); }

  /* contrast (on dark) */
  .contrast { margin-top: var(--s-4); }
  .contrast__col { padding: var(--s-6); border-radius: var(--radius-lg); }
  .contrast__col h3 { font-size: var(--fs-2); margin-bottom: var(--s-4); }
  .contrast__col ul { margin: 0; }
  .contrast__col li { margin-top: var(--s-3); }
  .contrast__col--no { border: 1px dashed var(--c-line-dark); color: var(--c-muted-dark); }
  .contrast__col--no ul { list-style: none; padding: 0; }
  .contrast__col--no li { padding-left: 1.75rem; position: relative; }
  .contrast__col--no li::before {
    content: '';
    position: absolute;
    left: 0.1rem;
    top: 0.75em;
    width: 0.9rem;
    height: 1px;
    background: var(--c-muted-dark);
  }
  .contrast__col--yes { background: var(--c-ink-2); border: 1px solid rgb(168 135 79 / 0.5); }

  /* journal */
  .notes { list-style: none; padding: 0; margin: 0; display: grid; gap: var(--s-5); }
  .note { margin: 0; padding: var(--s-5) 0; border-top: 1px solid var(--c-ink); position: relative; max-width: 46rem; }
  .note::before { content: ''; position: absolute; left: 0; right: 0; top: 3px; border-top: 1px solid var(--c-line); }
  .note__meta { font-size: var(--fs--1); letter-spacing: 0.08em; text-transform: uppercase; color: var(--c-terracotta-text); margin: 0 0 var(--s-2); }
