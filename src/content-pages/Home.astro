---
import Base from '../layouts/Base.astro';
import CellarMockup from '../components/CellarMockup.astro';
import SecHead from '../components/SecHead.astro';
import Icon from '../components/Icon.astro';
import MarginNote from '../components/MarginNote.astro';
import CtaBand from '../components/CtaBand.astro';
import { t, localize, ROUTES } from '../i18n/ui';
import { SITE, type Lang } from '../config';

interface Props { lang: Lang }
const { lang } = Astro.props;
const s = t(lang);
const L = (p: string) => localize(lang, p);

const C = {
  en: {
    title: 'Terroir — a wine assistant that knows your cellar, your taste and your kitchen',
    description: 'Terroir remembers the bottles you own, how you like your wine and what you cook — and answers “what should I open tonight?” from your own shelf. Early access: web app and Telegram.',
    kicker: 'Early access · web app & Telegram',
    h1: 'What to open tonight — <em>from your own cellar.</em>',
    sub: 'Terroir is a personal wine assistant with a memory. It knows which bottles you have and where they lie, how you like your wine, and what you cook at home — so its answers come from your shelf, not from the whole internet.',
    cta2: 'See how it works',
    note: 'real answers come only from bottles you actually own',
    remembers: {
      no: '01',
      title: 'Three things Terroir <em>remembers</em>',
      lede: 'Most wine apps know about wine. Terroir knows about <em>you</em> — and keeps that memory between conversations.',
      items: [
        { icon: 'rack', h: 'Your cellar', p: 'Every bottle, how many are left, which shelf it’s on and when its drinking window opens and closes. Ten bottles in a kitchen rack or two hundred in a basement — same care.' },
        { icon: 'palate', h: 'Your taste', p: 'A short questionnaire to start, then every rating sharpens the picture. Dry or off-dry, oak or none, light or structured — learnt from what you drink, not from a quiz score.' },
        { icon: 'book', h: 'Your kitchen', p: 'The dishes you actually cook: grandmother’s khinkali, Sunday ragù, pork neck on the grill. Terroir pairs wine with your recipes and recipes with your wine.' },
      ],
    },
    evening: {
      no: '02',
      title: 'One week, <em>three evenings</em>',
      lede: 'This is what Terroir is for — not tasting notes for their own sake, but small decisions at home.',
      items: [
        { day: 'Friday, 19:40', h: 'What to open with dinner?', p: 'Duck breast is resting, you’re tired, you don’t want to think. Terroir looks at the shelf: “Saperavi 2018 is entering its peak, you have three. You liked the last one more after an hour open.”', tag: 'from the cellar' },
        { day: 'Saturday, guests at eight', h: 'Friends are coming for an Italian night', p: 'Ragù is on the stove, six people, a mix of tastes. Terroir suggests two bottles you own that will cover the table — and notes which one your partner tends to prefer.', tag: 'from your recipes' },
        { day: 'Some quiet Sunday', h: 'The bottle you’ve been saving', p: 'Everyone has one. Terroir remembers it too, and tells you gently when its window starts to close — so it’s opened at its best, not forgotten until it’s past.', tag: 'drinking window' },
      ],
    },
    notThis: {
      no: '03',
      title: 'Not another label scanner. <em>Not a chat that forgets.</em>',
      lede: 'There are apps that know every wine in the world, and chatbots that will talk about any of them. Neither knows what’s on your shelf tonight.',
      leftH: 'What Terroir isn’t',
      left: [
        'A catalogue of every wine ever made, with somebody else’s ratings',
        'A chat that starts from zero each time and recommends bottles you don’t own',
        'A shop, a marketplace or an affiliate link in disguise',
      ],
      rightH: 'What Terroir is',
      right: [
        'An inventory of your bottles, with quantities, places and drinking windows',
        'A memory of your taste and your recipes that gets better with every rating',
        'An assistant that answers only from what you have — and says so when nothing fits',
      ],
    },
    who: {
      no: '04',
      title: 'Made for people who <em>cook at home</em> and open a bottle with dinner',
      items: [
        { icon: 'book', h: 'Home cooks & couples', p: 'One shared cellar, two different palates. Each of you rates for yourself.' },
        { icon: 'rack', h: 'Keepers of a small cellar', p: 'Ten to two hundred bottles — enough to lose track, too few for a spreadsheet hobby.' },
        { icon: 'leaf', h: 'Lovers of local grapes', p: 'Saperavi, Krasnostop, Areni, Kokur — Terroir is happy far from the usual suspects.' },
        { icon: 'pair', h: 'Hosts of wine evenings', p: 'Themed dinners with friends: Italy and Bolognese, France and braised beef cheeks.' },
      ],
      more: 'Who it’s for',
    },
    privacy: {
      no: '05',
      title: 'Your cellar is <em>your data</em>',
      items: [
        ['Export anytime', 'Your whole cellar, ratings and notes as a CSV file. Take it anywhere.'],
        ['No selling, no ads', 'We don’t sell data and we don’t take money from wineries to push bottles.'],
        ['Delete on request', 'Ask once, and your account and data are erased.'],
      ],
      link: 'Privacy notice (draft)',
    },
  },
  ru: {
    title: 'Terroir — винный помощник, который знает ваш погреб, вкус и кухню',
    description: 'Terroir помнит, какие бутылки у вас есть, какое вино вам нравится и что вы готовите, — и отвечает на вопрос «что открыть сегодня?» из вашего собственного погреба. Ранний доступ: веб и Telegram.',
    kicker: 'Ранний доступ · веб и Telegram',
    h1: 'Что открыть сегодня — <em>из своего погреба.</em>',
    sub: 'Terroir — личный винный помощник с памятью. Он знает, какие бутылки у вас есть и где они лежат, какое вино вам по вкусу и что вы готовите дома. Поэтому отвечает из вашей полки, а не из всего интернета.',
    cta2: 'Как это работает',
    note: 'советует только то, что реально стоит у вас на полке',
    remembers: {
      no: '01',
      title: 'Три вещи, которые Terroir <em>помнит</em>',
      lede: 'Большинство винных приложений знают о вине. Terroir знает о <em>вас</em> — и не забывает этого между разговорами.',
      items: [
        { icon: 'rack', h: 'Ваш погреб', p: 'Каждая бутылка: сколько осталось, на какой полке лежит, когда открывается и закрывается окно питья. Десять бутылок на кухне или двести в подвале — одинаково бережно.' },
        { icon: 'palate', h: 'Ваш вкус', p: 'Короткий опрос на старте, дальше каждая оценка уточняет картину. Сухое или полусухое, с дубом или без, лёгкое или плотное — по тому, что вы пьёте, а не по баллам теста.' },
        { icon: 'book', h: 'Ваша кухня', p: 'Блюда, которые вы правда готовите: бабушкины хинкали, воскресное рагу, свиная шея на углях. Terroir подбирает вино к вашим рецептам и рецепт — к вашей бутылке.' },
      ],
    },
    evening: {
      no: '02',
      title: 'Одна неделя, <em>три вечера</em>',
      lede: 'Вот для чего Terroir: не дегустационные заметки ради заметок, а маленькие домашние решения.',
      items: [
        { day: 'Пятница, 19:40', h: 'Что открыть к ужину?', p: 'Утиная грудка отдыхает, сил думать нет. Terroir смотрит на полку: «Саперави 2018 входит в пик, у вас три бутылки. Прошлую вы оценили выше, когда она постояла открытой час».', tag: 'из погреба' },
        { day: 'Суббота, гости к восьми', h: 'Друзья придут на итальянский ужин', p: 'Рагу на плите, шесть человек, вкусы разные. Terroir предложит две ваши бутылки, которые закроют весь стол, и подскажет, какую из них обычно выбирает ваш партнёр.', tag: 'из ваших рецептов' },
        { day: 'Какое-нибудь тихое воскресенье', h: 'Бутылка, которую жалко открывать', p: 'Такая есть у всех. Terroir тоже её помнит и мягко подскажет, когда окно начнёт закрываться, — чтобы открыть её в лучшей форме, а не вспомнить слишком поздно.', tag: 'окно питья' },
      ],
    },
    notThis: {
      no: '03',
      title: 'Не очередной сканер этикеток. <em>Не чат, который забывает.</em>',
      lede: 'Есть приложения, которые знают все вина мира, и чат-боты, готовые поговорить о любом из них. Ни те, ни другие не знают, что стоит у вас на полке сегодня.',
      leftH: 'Чем Terroir не является',
      left: [
        'Каталогом всех вин на свете с чужими оценками',
        'Чатом, который каждый раз начинает с нуля и советует то, чего у вас нет',
        'Магазином, маркетплейсом или замаскированной партнёрской ссылкой',
      ],
      rightH: 'Что такое Terroir',
      right: [
        'Учёт ваших бутылок: количество, место, окно питья',
        'Память о вашем вкусе и рецептах, которая точнее с каждой оценкой',
        'Помощник, который отвечает только из того, что у вас есть, — и честно говорит, если ничего не подходит',
      ],
    },
    who: {
      no: '04',
      title: 'Для тех, кто <em>готовит дома</em> и открывает бутылку к ужину',
      items: [
        { icon: 'book', h: 'Домашние повара и пары', p: 'Один общий погреб, два разных вкуса. Каждый оценивает за себя.' },
        { icon: 'rack', h: 'Хранители небольшого погреба', p: 'От десяти до двухсот бутылок — достаточно, чтобы запутаться, и слишком мало для таблиц.' },
        { icon: 'leaf', h: 'Любители локальных сортов', p: 'Саперави, Красностоп, Арени, Кокур — Terroir чувствует себя уверенно вдали от привычной классики.' },
        { icon: 'pair', h: 'Хозяева винных вечеров', p: 'Тематические ужины с друзьями: Италия и болоньезе, Франция и томлёные говяжьи щёки.' },
      ],
      more: 'Для кого Terroir',
    },
    privacy: {
      no: '05',
      title: 'Ваш погреб — <em>ваши данные</em>',
      items: [
        ['Экспорт в любой момент', 'Весь погреб, оценки и заметки — одним CSV-файлом. Берите куда угодно.'],
        ['Без продажи данных и рекламы', 'Мы не продаём данные и не берём денег у виноделен за продвижение бутылок.'],
        ['Удаление по запросу', 'Попросите один раз — аккаунт и данные будут удалены.'],
      ],
      link: 'Политика конфиденциальности (черновик)',
    },
  },
}[lang];

const app = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'Terroir',
  applicationCategory: 'LifestyleApplication',
  operatingSystem: 'Web, Telegram',
  description: C.description,
  url: new URL(L('/'), SITE.url).href,
  inLanguage: lang,
  publisher: { '@id': `${SITE.url}/#org` },
};
---

<Base lang={lang} title={C.title} fullTitle description={C.description} path="/" jsonld={[app]}>
  <!-- HERO -->
  <section class="hero">
    <div class="wrap hero__grid">
      <div class="hero__copy">
        <p class="kicker rise">{C.kicker}</p>
        <h1 class="rise rise-1" set:html={C.h1} />
        <p class="lede rise rise-2">{C.sub}</p>
        <div class="btn-row rise rise-3">
          <a class="btn" href={L(ROUTES.early)}>{s.cta}</a>
          <a class="btn btn--ghost" href={L(ROUTES.how)}>{C.cta2}</a>
        </div>
      </div>
      <div class="hero__visual">
        <CellarMockup lang={lang} />
        <MarginNote class="hero__note" dir="left">{C.note}</MarginNote>
      </div>
    </div>
  </section>

  <!-- 01 · REMEMBERS -->
  <section class="section section--paper" aria-labelledby="h-remembers">
    <div class="wrap">
      <SecHead no={C.remembers.no} title={C.remembers.title} lede={C.remembers.lede} id="h-remembers" />
      <div class="grid grid--3 remembers">
        {C.remembers.items.map((it, i) => (
          <article class="remember">
            <p class="remember__no" aria-hidden="true">{['I', 'II', 'III'][i]}</p>
            <Icon name={it.icon as any} class="card__icon" />
            <h3>{it.h}</h3>
            <p>{it.p}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- 02 · EVENINGS -->
  <section class="section" aria-labelledby="h-evenings">
    <div class="wrap">
      <SecHead no={C.evening.no} title={C.evening.title} lede={C.evening.lede} id="h-evenings" />
      <ol class="evenings">
        {C.evening.items.map((it) => (
          <li class="evening">
            <p class="evening__day">{it.day}</p>
            <div>
              <h3>{it.h}</h3>
              <p>{it.p}</p>
              <span class="tag">{it.tag}</span>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- 03 · NOT THIS -->
  <section class="section section--dark" aria-labelledby="h-not">
    <div class="wrap">
      <SecHead no={C.notThis.no} title={C.notThis.title} lede={C.notThis.lede} id="h-not" />
      <div class="grid grid--2 contrast">
        <div class="contrast__col contrast__col--no">
          <h3>{C.notThis.leftH}</h3>
          <ul>{C.notThis.left.map((x) => <li>{x}</li>)}</ul>
        </div>
        <div class="contrast__col contrast__col--yes">
          <h3>{C.notThis.rightH}</h3>
          <ul class="checks">{C.notThis.right.map((x) => <li>{x}</li>)}</ul>
        </div>
      </div>
    </div>
  </section>

  <!-- 04 · WHO -->
  <section class="section" aria-labelledby="h-who">
    <div class="wrap">
      <SecHead no={C.who.no} title={C.who.title} id="h-who" />
      <div class="who">
        {C.who.items.map((it) => (
          <article class="who__item">
            <Icon name={it.icon as any} class="who__icon" />
            <h3>{it.h}</h3>
            <p>{it.p}</p>
          </article>
        ))}
      </div>
      <p class="mt-6"><a class="text-link" href={L(ROUTES.for)}>{C.who.more}</a></p>
    </div>
  </section>

  <!-- 05 · PRIVACY -->
  <section class="section section--tight section--paper" aria-labelledby="h-privacy">
    <div class="wrap privacy">
      <div>
        <SecHead no={C.privacy.no} title={C.privacy.title} id="h-privacy" />
        <a class="text-link" href={L(ROUTES.privacy)}>{C.privacy.link}</a>
      </div>
      <dl class="privacy__list">
        {C.privacy.items.map(([dt, dd]) => (
          <div>
            <dt>{dt}</dt>
            <dd>{dd}</dd>
          </div>
        ))}
      </dl>
    </div>
  </section>

  <CtaBand lang={lang} secondary={{ href: L(ROUTES.faq), label: s.nav.faq }} />
</Base>

<style>
  /* hero */
  .hero { padding-block: clamp(2.5rem, 2rem + 4vw, 6rem) var(--s-9); position: relative; overflow: hidden; }
  .hero::before {
    content: '';
    position: absolute;
    inset: auto -10% 0 auto;
    width: 60%;
    height: 70%;
    background: radial-gradient(closest-side, rgb(201 164 92 / 0.18), transparent);
    pointer-events: none;
  }
  .hero__grid { display: grid; grid-template-columns: minmax(0, 1fr); gap: var(--s-8); align-items: center; position: relative; }
  .hero h1 { font-size: var(--fs-6); max-width: 13ch; margin-bottom: var(--s-5); }
  .hero .lede { margin-bottom: var(--s-6); }
  .hero__visual { position: relative; }
  :global(.hero__note) { position: absolute; right: 0.5rem; top: calc(100% + 0.75rem); margin: 0; }
  @media (min-width: 1024px) {
    .hero__grid { grid-template-columns: minmax(0, 1fr) minmax(0, 1.08fr); gap: var(--s-7); }
    :global(.hero__note) { right: auto; left: -1rem; }
  }
  @media (max-width: 639px) {
    :global(.hero__note) { position: static; margin-top: var(--s-4); }
  }

  /* remembers */
  .remember {
    position: relative;
    padding: var(--s-6) var(--s-5) var(--s-5);
    border-top: 1px solid var(--c-ink);
  }
  .remember::before {
    content: '';
    position: absolute;
    left: 0; right: 0; top: 3px;
    border-top: 1px solid var(--c-line);
  }
  .remember__no {
    position: absolute;
    right: var(--s-5);
    top: var(--s-5);
    font-family: var(--f-display);
    font-style: italic;
    font-size: var(--fs-3);
    color: var(--c-gold);
    line-height: 1;
    margin: 0;
  }
  .remember h3 { font-size: var(--fs-3); font-weight: 500; }
  .remember p { color: var(--c-muted); margin: 0; }
  @media (min-width: 768px) { .remember { padding-inline: 0 var(--s-6); } }

  /* evenings */
  .evenings { list-style: none; padding: 0; margin: 0; }
  .evening {
    display: grid;
    gap: var(--s-2) var(--s-7);
    padding-block: var(--s-6);
    border-top: 1px solid var(--c-line);
    margin: 0;
  }
  .evening:last-child { border-bottom: 1px solid var(--c-line); }
  .evening__day {
    font-family: var(--f-display);
    font-style: italic;
    font-size: var(--fs-2);
    color: var(--c-merlot);
    line-height: 1.2;
    margin: 0;
  }
  .evening h3 { font-size: var(--fs-3); font-weight: 500; margin-bottom: var(--s-3); }
  .evening p { max-width: 60ch; color: #3b2730; }
  @media (min-width: 1024px) {
    .evening { grid-template-columns: 16rem minmax(0, 1fr); }
  }

  /* contrast */
  .contrast { margin-top: var(--s-4); }
  .contrast__col { padding: var(--s-6); border-radius: var(--radius-lg); }
  .contrast__col h3 { font-size: var(--fs-2); margin-bottom: var(--s-4); }
  .contrast__col ul { margin: 0; }
  .contrast__col li { margin-top: var(--s-3); }
  .contrast__col--no { border: 1px dashed var(--c-line-dark); color: var(--c-muted-dark); }
  .contrast__col--no ul { list-style: none; padding: 0; }
  .contrast__col--no li { padding-left: 1.75rem; position: relative; }
  .contrast__col--no li::before {
    content: '';
    position: absolute;
    left: 0.1rem;
    top: 0.75em;
    width: 0.9rem;
    height: 1px;
    background: var(--c-muted-dark);
  }
  .contrast__col--yes { background: var(--c-ink-2); border: 1px solid rgb(201 164 92 / 0.45); }

  /* who */
  .who { display: grid; gap: var(--s-6); }
  .who__item { border-left: 1px solid var(--c-gold); padding-left: var(--s-5); }
  :global(.who__icon) { width: 2.5rem; height: 2.5rem; color: var(--c-merlot); margin-bottom: var(--s-3); }
  .who__item h3 { font-size: var(--fs-2); margin-bottom: var(--s-2); }
  .who__item p { margin: 0; color: var(--c-muted); }
  @media (min-width: 768px) { .who { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 1200px) { .who { grid-template-columns: repeat(4, 1fr); } }

  /* privacy */
  .privacy { display: grid; gap: var(--s-6); }
  .privacy :global(.sec-head) { margin-bottom: var(--s-4); }
  .privacy__list { display: grid; gap: var(--s-5); margin: 0; }
  .privacy__list div { border-top: 1px solid var(--c-line); padding-top: var(--s-4); }
  .privacy__list dt { font-family: var(--f-display); font-size: var(--fs-2); font-weight: 600; margin-bottom: var(--s-2); }
  .privacy__list dd { margin: 0; color: var(--c-muted); }
  @media (min-width: 1024px) {
    .privacy { grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); gap: var(--s-8); }
    .privacy__list { grid-template-columns: repeat(3, 1fr); }
  }
</style>
